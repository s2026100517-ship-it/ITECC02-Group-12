// Invalid number input
void invalidNumber() {
    cin.clear();
    cin.ignore(1000, '\n');

    cout << "\n";
    cout << "=====================================================" << endl;
    cout << "      Invalid input! Please enter numbers only." << endl;
    cout << "=====================================================" << endl;
    cout << "\n";
}

// Invalid Y/N input
void invalidYesNo() {
    cout << "\n";
    cout << "=====================================================" << endl;
    cout << "         Invalid input. Please enter Y or N." << endl;
    cout << "=====================================================" << endl;
    cout << "\n\n";
}

// Other invalid input messages
void invalidInput(string message) {
    cout << "\n";
    cout << "=====================================================" << endl;
    cout << "   " << message << endl;
    cout << "=====================================================" << endl;
    cout << "\n";
}

//Returning message
void goBack(string returnMessage) {
    cout << "\n";
    cout << "\t " << returnMessage << "..." << endl;
    cout << "\n";
}

// Confirmation validation
void confirmation(char &confirm, bool &confirmed, string returnMessage) {
    do {
        cout << "-----------------------------------------------------" << endl;
        cout << "\n";
        cout << "\t Enter Y to confirm or N to return: ";
        cin >> confirm;
        //Confirm
        if (confirm == 'Y' || confirm == 'y') {
            confirmed = true;
            cout << "\n";
            cout << "              Confirmation successful!" << endl;
            cout << "\n";
        }
        //Return
        else if (confirm == 'N' || confirm == 'n') {
            confirmed = false;
            goBack(returnMessage);
        }
        //Not Y/N
        else {
            invalidYesNo();
        }

    } while (confirm != 'Y' && confirm != 'y' &&
             confirm != 'N' && confirm != 'n');

    cout << "-----------------------------------------------------" << endl;
}

// Invalid selection
void invalidSelection(string selectMessage) {
    cout << "\n";
    cout << "=====================================================" << endl;
    cout << "              Invalid " << selectMessage << " selection." << endl;
    cout << "=====================================================" << endl;
    cout << "\n";
}


// Return to a previous section or end the current transaction
void returnEnd(char &confirm, bool &confirmed, string returnEndMessage) {
    do {
        cout << "\n";
        cout << "   Would you like to return to " << returnEndMessage << "?" << endl;
        cout << "\n";
        cout << "   Enter Y to confirm or N to end transaction: ";
        cin >> confirm;
        //Not Y/N
        if (confirm != 'Y' && confirm != 'y' &&
            confirm != 'N' && confirm != 'n') {
            invalidYesNo();
        }

    } while (confirm != 'Y' && confirm != 'y' &&
             confirm != 'N' && confirm != 'n');
    //Return
    if (confirm == 'Y' || confirm == 'y') {
        confirmed = true;
        goBack("Returning to " + returnEndMessage);
    }
    //End transaction
    else {
        confirmed = false;
        cout << "\n\t\t  Transaction ended." << endl;
    }
}

// Senior citizen discount
double seniorDiscount(double total, int age) {
    if (age >= 60) {
        return total * 0.20;
    }
    return 0.0;
}

